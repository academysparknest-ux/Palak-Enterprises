# Supabase Configuration (Required)
# Get these from your Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Canonical URL (Used for QR verification links)
VITE_APP_URL=https://your-production-domain.com

# Razorpay Publishable Key (Client-side only — NEVER put secret key here)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# ⚠️ IMPORTANT: Razorpay Secret Key (RAZORPAY_KEY_SECRET) must NEVER be placed
# in this file. It belongs only in server-side environment configuration
# (e.g., Vercel Environment Variables, server .env).
